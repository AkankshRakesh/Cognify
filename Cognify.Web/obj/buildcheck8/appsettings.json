{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=CognifyDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ScoringConfig": {
    "ConfidenceMultipliers": {
      "CorrectHigh": 1.5,
      "CorrectMedium": 1.0,
      "CorrectLow": 0.75,
      "WrongHigh": -1.0,
      "WrongMedium": -0.5,
      "WrongLow": -0.25
    }
  },
  "AllowedHosts": "*"
}
