@model Cognify.Web.ViewModels.ExamAttemptVM
@{
    ViewData["Title"] = "Exam: " + Model.ExamTitle;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <style>
        .exam-option {
            background: var(--d-panel-2, #1d2639);
            border: 2px solid var(--d-line, #2c3855);
            padding: 1rem 1.25rem;
            margin-bottom: 0.85rem;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 1rem;
            border-radius: 4px;
        }
        .exam-option:hover {
            border-color: var(--d-amber, #f5b83d);
            background: #232e44;
        }
        .exam-option input[type="radio"] {
            transform: scale(1.3);
            accent-color: var(--d-amber, #f5b83d);
        }
        .confidence-box {
            background: rgba(46, 196, 182, 0.08);
            border: 1px dashed var(--d-teal, #2ec4b6);
            padding: 1.25rem;
            margin: 1.5rem 0;
            border-radius: 4px;
        }
    </style>
}

<div class="dash">
    <div class="container dash-wrap">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1 class="h3 fw-bold mt-2 text-white">@Model.ExamTitle</h1>
            </div>
            <div class="text-end">
                <span class="badge bg-warning fs-6 px-3 py-2">
                    Question @Model.CurrentQuestionNumber of @Model.TotalQuestionCount
                </span>
                <div class="mt-2">
                    <span class="badge bg-danger fs-6 px-3 py-2" id="exam-countdown" role="timer" aria-label="Time remaining">
                        Time left: <span id="exam-countdown-value">@TimeSpan.FromSeconds(Model.SecondsRemaining).ToString(@"hh\:mm\:ss")</span>
                    </span>
                </div>
            </div>
        </div>

        <form id="exam-answer-form" asp-controller="ExamAttempt" asp-action="SubmitAnswer" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="AttemptToken" value="@Model.AttemptToken" />
            <input type="hidden" name="QuestionToken" value="@Model.QuestionToken" />

            <div class="px mb-4">
                <h2 class="h5 fw-bold text-white mb-4">@Model.QuestionText</h2>

                <label class="exam-option d-block">
                    <input type="radio" name="SelectedOption" value="A" required />
                    <strong class="text-warning">A.</strong>
                    <span>@Model.OptionA</span>
                </label>

                <label class="exam-option d-block">
                    <input type="radio" name="SelectedOption" value="B" required />
                    <strong class="text-warning">B.</strong>
                    <span>@Model.OptionB</span>
                </label>

                @if (!string.IsNullOrEmpty(Model.OptionC))
                {
                    <label class="exam-option d-block">
                        <input type="radio" name="SelectedOption" value="C" required />
                        <strong class="text-warning">C.</strong>
                        <span>@Model.OptionC</span>
                    </label>
                }

                @if (!string.IsNullOrEmpty(Model.OptionD))
                {
                    <label class="exam-option d-block">
                        <input type="radio" name="SelectedOption" value="D" required />
                        <strong class="text-warning">D.</strong>
                        <span>@Model.OptionD</span>
                    </label>
                }

                @if (Model.ShowConfidenceSlider)
                {
                    <div class="confidence-box">
                        <h6 class="fw-bold text-info mb-2">&#x25C8; Confidence-Weighted Assessment</h6>
                        @if (Model.IsAdaptive)
                        {
                            <p class="small text-muted mb-3">
                                Record your confidence for the calibration report. The adaptive Bayesian grade is based on your response pattern.
                            </p>
                        }
                        else
                        {
                            <p class="small text-muted mb-3">
                                How confident are you in this answer? High confidence increases marks if correct
                                @if (Model.NegativeMarking)
                                {
                                    <span>and increases the penalty if wrong.</span>
                                }
                                else
                                {
                                    <span>; incorrect answers receive no penalty.</span>
                                }
                            </p>
                        }

                        <div class="d-flex gap-4">
                            <label class="d-flex align-items-center gap-2 text-light">
                                <input type="radio" name="ConfidenceLevel" value="Low" />
                                @if (Model.IsAdaptive)
                                {
                                    <span>Low Confidence</span>
                                }
                                else
                                {
                                    <span>Low Confidence</span>
                                }
                            </label>
                            <label class="d-flex align-items-center gap-2 text-light">
                                <input type="radio" name="ConfidenceLevel" value="Medium" checked />
                                @if (Model.IsAdaptive)
                                {
                                    <span>Medium Confidence</span>
                                }
                                else
                                {
                                    <span>Medium Confidence</span>
                                }
                            </label>
                            <label class="d-flex align-items-center gap-2 text-light">
                                <input type="radio" name="ConfidenceLevel" value="High" />
                                @if (Model.IsAdaptive)
                                {
                                    <span>High Confidence</span>
                                }
                                else
                                {
                                    <span>High Confidence</span>
                                }
                            </label>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Leave Exam</a>
                    <div class="d-flex gap-2">
                        <button id="skip-question" type="submit" name="Skip" value="true" formnovalidate class="btn btn-outline-light">
                            @(Model.IsLastQuestion ? "Skip and end exam" : "Skip question")
                        </button>
                        <button type="submit" class="px-btn">
                            @(Model.IsLastQuestion ? "End Exam" : "Next Question")@if (!Model.IsLastQuestion) { <text> &rarr;</text> }
                        </button>
                    </div>
                </div>

            </div>
        </form>

    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const countdown = document.getElementById("exam-countdown-value");
            const skipButton = document.getElementById("skip-question");
            const deadline = Date.now() + @Model.SecondsRemaining * 1000;
            let expired = false;

            const updateCountdown = () => {
                const secondsLeft = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
                const hours = Math.floor(secondsLeft / 3600);
                const minutes = Math.floor((secondsLeft % 3600) / 60);
                const seconds = secondsLeft % 60;
                countdown.textContent = [hours, minutes, seconds]
                    .map(value => String(value).padStart(2, "0"))
                    .join(":");

                if (secondsLeft === 0 && !expired) {
                    expired = true;
                    skipButton.click();
                }
            };

            updateCountdown();
            window.setInterval(updateCountdown, 1000);
        })();
    </script>
}
