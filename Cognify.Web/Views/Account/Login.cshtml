@model LoginVM
@{
    ViewData["Title"] = "Log In";
}

<section class="section" style="padding-top:60px; background-image: url('/images/bg.gif'); background-repeat: no-repeat; background-position: center; background-size: cover;">
    <div class="container" style="max-width:440px;">
        <div class="text-center mb-4">
            <span class="section-eyebrow">Welcome Back</span>
            <h1 class="section-title" style="font-size:1.9rem;">Log in to Cognify</h1>
        </div>

        <div class="role-card">
            <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small"></label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold small"></label>
                    <input asp-for="Password" class="form-control" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small"></label>
                </div>

                <button type="submit" class="btn btn-brand w-100">Log In</button>
            </form>

            <p class="text-center small text-muted mt-4 mb-0">
                Don't have an account?
                <a asp-controller="Account" asp-action="Register" class="fw-semibold" style="color:var(--teal-deep);">Sign up</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
