@model RegisterVM
@{
    ViewData["Title"] = "Sign Up";
}

<section class="auth-hero-bg">
    <div class="auth-overlay"></div>

    <div class="container" style="max-width:480px;">
        <div class="text-center mb-4">
            <span class="auth-eyebrow-onbg">Get Started</span>
            <h1 class="auth-title-onbg display-font fw-bold">Create your Cognify account</h1>
        </div>

        <div class="role-card">
            <form asp-controller="Account" asp-action="Register" method="post" novalidate>

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small"></label>
                    <input asp-for="Name" class="form-control" placeholder="Jane Doe" autocomplete="name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small"></label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label fw-semibold small"></label>
                    <select asp-for="Role" class="form-select">
                        <option value="@Cognify.Core.Enums.UserRole.Student">Student &mdash; I want to attempt exams</option>
                        <option value="@Cognify.Core.Enums.UserRole.Teacher">Teacher &mdash; I want to create exams</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold small"></label>
                    <input asp-for="Password" class="form-control" placeholder="At least 6 characters" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-brand w-100">Create Account</button>
            </form>

            <p class="text-center small text-muted mt-4 mb-0">
                Already have an account?
                <a asp-controller="Account" asp-action="Login" class="fw-semibold" style="color:var(--teal-deep);">Log in</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
