
@model Cognify.Web.ViewModels.QuestionBankIndexVM
@inject Cognify.Web.Security.IUrlTokenProtector UrlTokens

@{
    ViewData["Title"] = "Question Bank";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dash">
    <div class="container dash-wrap">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success bg-dark text-success border-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger bg-dark text-danger border-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <section class="px px-hero">

            <div class="hero-main">
                <p class="hero-hello">
                    Teacher workspace
                </p>
                <h1 class="hero-level">Question bank catalog</h1>
                <p class="muted mb-0">
                    Review shared sample question banks. Teachers can also manage their own banks.
                </p>
            </div>

            @if (User.IsInRole("Teacher"))
            {
                <a asp-action="CreateSet" class="px-btn">
                    + New question bank
                </a>
            }
        </section>

        <div class="d-flex justify-content-between align-items-end mb-3">
            <div>
                <h2 class="px-title mb-1">Question banks</h2>
                <p class="muted mb-0">
                    Use the shared sample bank for exams, or manage your own banks.
                </p>
            </div>

            <span class="catalog-count">
                @Model.QuestionSets.Count bank@(Model.QuestionSets.Count == 1 ? "" : "s")
            </span>
        </div>

        @if (!Model.QuestionSets.Any())
        {
            <div class="px px-empty">
                <p>No question banks yet.</p>
                <small>Create a question bank to start building exams.</small>
            </div>
        }

        <div class="row g-4">
            @foreach (var set in Model.QuestionSets)
            {
                <div class="col-md-6 col-xl-4">
                    <a asp-action="EditSet"
                       asp-route-token="@UrlTokens.ProtectQuestionSet(set.QuestionSetId)"
                       class="question-bank-card px d-block h-100">

                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <span class="tag tag-subject">@set.Subject</span>
                            <span class="bank-arrow">&rarr;</span>
                        </div>

                        <h2>@set.Title</h2>
                        @if (set.IsBuiltIn)
                        {
                            <p class="muted small">Built-in sample · Read-only</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(set.Description))
                        {
                            <p class="muted small">@set.Description</p>
                        }

                        <div class="bank-meta">
                            <span>
                                <strong>@set.QuestionCount</strong> questions
                            </span>

                            <span>
                                <strong>@set.TotalMarks</strong> marks
                            </span>
                        </div>

                        <small class="text-muted">
                            Created @set.CreatedOn.ToLocalTime().ToString("dd MMM yyyy")
                        </small>
                    </a>
                </div>
            }
        </div>

    </div>
</div>
