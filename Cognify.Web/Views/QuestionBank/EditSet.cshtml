
@model Cognify.Web.ViewModels.QuestionSetCreateVM
@inject Cognify.Web.Security.IUrlTokenProtector UrlTokens

@{
    ViewData["Title"] = "Edit Question Bank";

    var concepts = ViewBag.Concepts as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();

    var questionItems = Model.Questions.Any()
        ? Model.Questions
        : new List<Cognify.Web.ViewModels.QuestionInputVM> { new() };
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dash">
    <div class="container question-set-page">

        <div class="editor-header">
            <div>

                <p class="hero-hello mt-3 mb-1">Question bank editor</p>

                <h1 class="text-white mb-2">@Model.Title</h1>

                <p class="muted mb-0">
                    Update this reusable bank before selecting it for an exam.
                </p>
            </div>

            <a asp-controller="Exam"
               asp-action="Create"
               class="btn btn-outline-warning btn-sm">
                Create exam
            </a>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger bg-dark border-danger text-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <form asp-action="EditSet"
              asp-route-token="@ViewBag.QuestionSetToken"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger bg-dark border-danger"
                 role="alert">
            </div>

            <section class="editor-section px mb-4">

                <div class="editor-section-heading">
                    <span class="editor-step">01</span>

                    <div>
                        <h2>Bank details</h2>
                        <p>
                            Keep the title and subject recognizable when choosing an exam question bank.
                        </p>
                    </div>
                </div>

                <div class="row g-3">

                    <div class="col-md-7">
                        <label asp-for="Title" class="form-label">
                            Bank name *
                        </label>

                        <input asp-for="Title" class="form-control-dark" />

                        <span asp-validation-for="Title"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="Subject" class="form-label">
                            Subject *
                        </label>

                        <input asp-for="Subject" class="form-control-dark" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label">
                            Description
                            <span class="text-muted">(optional)</span>
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control-dark"
                                  rows="2">
                        </textarea>
                    </div>

                    <div class="col-md-7">
                        <label asp-for="ConceptTagId" class="form-label">
                            Concept for new questions
                        </label>

                        <select asp-for="ConceptTagId" class="form-select-dark">
                            <option value="">Select an existing concept</option>

                            @foreach (var c in concepts)
                            {
                                <option value="@c.ConceptTagId">
                                    @c.Name · @c.Subject
                                </option>
                            }
                        </select>

                        <input asp-for="NewConceptName"
                               class="form-control-dark mt-2"
                               placeholder="Or add a new concept name" />
                    </div>

                </div>
            </section>

            <section class="editor-section px mb-4">

                <div class="editor-section-heading">
                    <span class="editor-step">02</span>

                    <div>
                        <h2>Questions in this bank</h2>
                        <p>
                            Remove a question from this bank or add more below. Changes are saved together.
                        </p>
                    </div>

                    <span class="editor-count" id="questionCount">
                        @questionItems.Count question@(questionItems.Count == 1 ? "" : "s")
                    </span>
                </div>

                <div id="questionItems">

                    @for (var i = 0; i < questionItems.Count; i++)
                    {
                        var q = questionItems[i];

                        <div class="question-editor-card" data-index="@i">

                            <input type="hidden"
                                   name="Questions[@i].QuestionId"
                                   value="@q.QuestionId" />

                            <div class="question-card-heading">
                                <span class="question-number">
                                    Question @(i + 1)@(q.QuestionId > 0 ? " · Existing" : " · New")
                                </span>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger remove-question @(questionItems.Count == 1 ? "d-none" : "")">
                                    Remove
                                </button>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Question text *
                                </label>

                                <textarea name="Questions[@i].Text"
                                          class="form-control-dark"
                                          rows="3"
                                          required>@q.Text</textarea>
                            </div>

                            <div class="row g-2 mb-3">

                                <div class="col-md-6">
                                    <input name="Questions[@i].OptionA"
                                           class="form-control-dark"
                                           value="@q.OptionA"
                                           required
                                           placeholder="Option A">
                                </div>

                                <div class="col-md-6">
                                    <input name="Questions[@i].OptionB"
                                           class="form-control-dark"
                                           value="@q.OptionB"
                                           required
                                           placeholder="Option B">
                                </div>

                                <div class="col-md-6">
                                    <input name="Questions[@i].OptionC"
                                           class="form-control-dark"
                                           value="@q.OptionC"
                                           required
                                           placeholder="Option C">
                                </div>

                                <div class="col-md-6">
                                    <input name="Questions[@i].OptionD"
                                           class="form-control-dark"
                                           value="@q.OptionD"
                                           required
                                           placeholder="Option D">
                                </div>

                            </div>

                            <div class="row g-2">

                                <div class="col-md-4">
                                    <label class="form-label small">
                                        Correct answer
                                    </label>

                                    <select name="Questions[@i].CorrectOption"
                                            class="form-select-dark">

                                        <option value="A" selected="@(q.CorrectOption == "A" ? "selected" : null)">
                                            Option A
                                        </option>

                                        <option value="B" selected="@(q.CorrectOption == "B" ? "selected" : null)">
                                            Option B
                                        </option>

                                        <option value="C" selected="@(q.CorrectOption == "C" ? "selected" : null)">
                                            Option C
                                        </option>

                                        <option value="D" selected="@(q.CorrectOption == "D" ? "selected" : null)">
                                            Option D
                                        </option>

                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label small">
                                        Difficulty
                                    </label>

                                    <select name="Questions[@i].DifficultyLevel"
                                            class="form-select-dark">

                                        <option value="Easy"
                                                selected="@(q.DifficultyLevel == Cognify.Core.Enums.DifficultyLevel.Easy ? "selected" : null)">
                                            Easy
                                        </option>

                                        <option value="Medium"
                                                selected="@(q.DifficultyLevel == Cognify.Core.Enums.DifficultyLevel.Medium ? "selected" : null)">
                                            Medium
                                        </option>

                                        <option value="Hard"
                                                selected="@(q.DifficultyLevel == Cognify.Core.Enums.DifficultyLevel.Hard ? "selected" : null)">
                                            Hard
                                        </option>

                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label small">
                                        Marks
                                    </label>

                                    <input name="Questions[@i].Marks"
                                           type="number"
                                           class="form-control-dark"
                                           value="@q.Marks"
                                           min="1"
                                           max="50">
                                </div>

                            </div>
                        </div>
                    }

                </div>

                <button type="button"
                        class="btn btn-outline-warning add-question-btn"
                        id="addQuestion">
                    + Add another question
                </button>

            </section>

            <div class="editor-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit" class="px-btn">
                    Save changes &rarr;
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const list = document.getElementById('questionItems');
            const count = document.getElementById('questionCount');

            let index = list.querySelectorAll('.question-editor-card').length;

            const template = i => `
                <div class="question-editor-card" data-index="${i}">

                    <input type="hidden"
                           name="Questions[${i}].QuestionId"
                           value="0">

                    <div class="question-card-heading">
                        <span class="question-number">
                            Question ${i + 1} · New
                        </span>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger remove-question">
                            Remove
                        </button>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Question text *</label>

                        <textarea name="Questions[${i}].Text"
                                  class="form-control-dark"
                                  rows="3"
                                  required
                                  placeholder="Write the question prompt"></textarea>
                    </div>

                    <div class="row g-2 mb-3">

                        <div class="col-md-6">
                            <input name="Questions[${i}].OptionA"
                                   class="form-control-dark"
                                   required
                                   placeholder="Option A">
                        </div>

                        <div class="col-md-6">
                            <input name="Questions[${i}].OptionB"
                                   class="form-control-dark"
                                   required
                                   placeholder="Option B">
                        </div>

                        <div class="col-md-6">
                            <input name="Questions[${i}].OptionC"
                                   class="form-control-dark"
                                   required
                                   placeholder="Option C">
                        </div>

                        <div class="col-md-6">
                            <input name="Questions[${i}].OptionD"
                                   class="form-control-dark"
                                   required
                                   placeholder="Option D">
                        </div>

                    </div>

                    <div class="row g-2">

                        <div class="col-md-4">
                            <label class="form-label small">Correct answer</label>

                            <select name="Questions[${i}].CorrectOption"
                                    class="form-select-dark">
                                <option value="A">Option A</option>
                                <option value="B">Option B</option>
                                <option value="C">Option C</option>
                                <option value="D">Option D</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small">Difficulty</label>

                            <select name="Questions[${i}].DifficultyLevel"
                                    class="form-select-dark">
                                <option value="Easy">Easy</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="Hard">Hard</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small">Marks</label>

                            <input name="Questions[${i}].Marks"
                                   type="number"
                                   class="form-control-dark"
                                   value="1"
                                   min="1"
                                   max="50">
                        </div>

                    </div>
                </div>
            `;

            function update() {
                const items = list.querySelectorAll('.question-editor-card');

                count.textContent = `${items.length} question${items.length === 1 ? '' : 's'}`;

                items.forEach((item, i) => {
                    const isNew = item.querySelector('input[type=hidden]').value === '0';

                    item.querySelector('.question-number').textContent =
                        isNew
                            ? `Question ${i + 1} · New`
                            : `Question ${i + 1} · Existing`;

                    item.querySelector('.remove-question').classList.toggle(
                        'd-none',
                        items.length === 1
                    );
                });
            }

            document.getElementById('addQuestion').addEventListener('click', () => {
                list.insertAdjacentHTML('beforeend', template(index++));
                update();
            });

            list.addEventListener('click', event => {
                if (
                    event.target.classList.contains('remove-question') &&
                    list.children.length > 1
                ) {
                    event.target.closest('.question-editor-card').remove();
                    update();
                }
            });
        })();
    </script>
}
