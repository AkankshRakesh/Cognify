<!DOCTYPE html>
<html lang="en" class="@(ViewData["NoScroll"] as bool? == true ? "no-scroll" : "")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cognify | Online Examination System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(ViewData["NoScroll"] as bool? == true ? "no-scroll" : "")">
    <div id="page-loader" aria-hidden="true">
        <img src="~/images/loading2.gif" alt="" />
    </div>

    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Cognify Logo" class="navbar-logo"/>Cognify
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMain">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm px-3" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>
                            @if (User.IsInRole("Teacher") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="btn btn-outline-info btn-sm px-3" asp-controller="QuestionBank" asp-action="Index">Question Bank</a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn btn-warning btn-sm px-3 fw-semibold " asp-controller="Exam" asp-action="Create">+ New Exam</a>
                                </li>
                            }   
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-brand btn-sm px-3">Log Out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-3 ">
                                <a class="btn btn-outline-light btn-sm px-3" asp-controller="Account" asp-action="Login">Log In</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-brand btn-sm px-3" asp-controller="Account" asp-action="Register">Get Started</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        <div id="page-content">
            @RenderBody()
        </div>
    </main>

    @* <footer class="site-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-4">
                    <div class="footer-brand"><span class="brand-mark">Ex</span>amAI</div>
                    <p class="text-muted small mt-2">
                        An adaptive, confidence-aware online examination and auto-evaluation platform
                        built for Smart Education. Submitted for Smart India Hackathon.
                    </p>
                </div>
                <div class="col-md-2">
                    <h6>Platform</h6>
                    <ul class="list-unstyled small">
                        <li><a href="#features">Features</a></li>
                        <li><a href="#how-it-works">How it Works</a></li>
                        <li><a asp-controller="ExamController" asp-action="Index">Exams</a></li>
                    </ul>
                </div>
                <div class="col-md-2">
                    <h6>For</h6>
                    <ul class="list-unstyled small">
                        <li>Students</li>
                        <li>Teachers</li>
                        <li>Institutions</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6>Smart India Hackathon</h6>
                    <p class="small text-muted mb-0">Category: Smart Education</p>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <p class="text-muted small mb-0">&copy; @DateTime.Now.Year Cognify &mdash; Online Examination and Auto-Evaluation System</p>
        </div>
    </footer> *@

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
