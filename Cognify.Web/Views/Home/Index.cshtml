@model HomeIndexVM
@{
    ViewData["Title"] = "Home";
}

<!-- ==========================================================================
     HERO
     ========================================================================== -->
<section class="hero hero-gif-bg">
    <div class="hero-overlay"></div>

    <div class="hero-content">
        <h1>
            Exams that adapt to
            <span class="accent-amber">the student</span>,
            scoring that rewards
            <span class="accent-teal">honest confidence</span>.
        </h1>

        <div class="hero-cta">
            <a class="btn-hero-primary"
               asp-controller="AccountController"
               asp-action="Register">
                Create your first exam
            </a>

            <a class="btn-hero-secondary" href="#how-it-works">
                See how scoring works
            </a>
        </div>

        <div class="hero-stats">
            <div class="hero-stat">
                <span class="num">@Model.TotalExamsConducted</span>
                <span class="label">Exams Conducted</span>
            </div>

            <div class="hero-stat">
                <span class="num">@Model.TotalQuestionsInBank.ToString("N0")</span>
                <span class="label">Questions in Bank</span>
            </div>

            <div class="hero-stat">
                <span class="num">@Model.TotalStudentsRegistered.ToString("N0")</span>
                <span class="label">Students</span>
            </div>

            <div class="hero-stat">
                <span class="num">@Model.AveragePassPercentage.ToString("0.0")%</span>
                <span class="label">Avg. Pass Rate</span>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     STUDENT DASHBOARD STRIP (only when logged in)
     ========================================================================== -->
